{
  "version": 1,
  "hooks": {
    "preToolUse": [
      { "type": "command", "bash": ".github/hooks/scripts/protect-secrets.sh", "timeoutSec": 30 },
      { "type": "command", "bash": ".github/hooks/scripts/block-force-push.sh", "timeoutSec": 30 },
      { "type": "command", "bash": ".github/hooks/scripts/guard-context-docs.sh", "timeoutSec": 30 }
    ],
    "postToolUse": [
      { "type": "command", "bash": ".github/hooks/scripts/format-kotlin.sh", "timeoutSec": 30 }
    ]
  }
}
